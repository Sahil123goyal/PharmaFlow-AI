# PharmaFlowAI — local environment template.
# Copy to ".env" and adjust. Never commit the real ".env".

# --- Core ------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Leave POSTGRES_DB blank to use the local SQLite file (no setup needed).
# Set it to switch the project onto PostgreSQL, as planned in the proposal.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Sessions --------------------------------------------------------------
# Lifetime, in seconds, of a "Remember me" session. Default: 14 days.
SESSION_COOKIE_AGE=1209600
